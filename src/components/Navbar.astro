---
const links = [
  { label: "Momenmu", href: "#kategori" },
  { label: "Inspirasi", href: "#galeri" },
  { label: "Rasa", href: "#rasa" },
  { label: "Harga", href: "#harga" },
  { label: "Dessert Table", href: "#dessert-table" },
];
---
<header class="site-header">
  <div class="announcement">
    <div class="container"><span>Dibuat khusus, untuk yang tersayang.</span><span>Pre-order · Jakarta Selatan</span></div>
  </div>
  <div class="container nav-row">
    <a href="#main-content" class="wordmark" aria-label="Chère Cake Atelier — beranda">
      <svg viewBox="0 0 32 36" fill="none" aria-hidden="true"><path d="M10 23C9 10 19 7 24 3M23 24C26 14 25 7 24 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M23 4C18 1 13 2 12 6c5 2 9 1 11-2Z" fill="currentColor"/><circle cx="9" cy="26" r="7" fill="currentColor"/><circle cx="24" cy="27" r="7" fill="currentColor"/><path d="M6 23l2-1M21 24l2-1" stroke="var(--paper)" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span>chère<small>cake atelier</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Navigasi utama">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <a href="#konsultasi" class="button nav-cta">Ceritakan kuemu <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    <details class="mobile-menu">
      <summary aria-label="Buka menu navigasi"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></summary>
      <nav aria-label="Navigasi mobile">{links.map(link => <a href={link.href}>{link.label}</a>)}<a href="#konsultasi" class="button">Ceritakan kuemu</a></nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => { menu.open = false; }));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
</script>
