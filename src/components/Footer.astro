---
import "../styles/details.css";
const socials = [
  { label: "Instagram", href: "https://instagram.com/cherecakeatelier" },
  { label: "TikTok", href: "https://tiktok.com/@cherecakeatelier" },
  { label: "WhatsApp", href: "https://wa.me/6281234567890" },
];
---

<footer class="atelier-footer">
  <div class="container">
    <div class="footer-invitation">
      <div class="footer-brand">
        <a href="#" aria-label="Chère Cake Atelier, kembali ke atas">
          <span class="footer-wordmark">Chère</span>
          <span class="footer-atelier">Cake Atelier</span>
        </a>
      </div>
      <div class="footer-message">
        <p class="footer-tagline">Setiap Kue,<br />Dirancang Untuk Ceritamu.</p>
        <p>Setiap potongan, kenangan yang dirayakan.</p>
        <a class="button footer-consult" href="#konsultasi">Mulai cerita kuemu</a>
      </div>
    </div>

    <div class="footer-details">
      <div>
        <h2>Temukan kami</h2>
        <address>
          <a href="tel:+6281234567890">+62 812-3456-7890</a>
          <a href="mailto:hello@cherecakeatelier.id">hello@cherecakeatelier.id</a>
          <span>Jakarta Selatan, Indonesia</span>
        </address>
        <p class="footer-service-area">Pengantaran dalam kota.</p>
      </div>
      <div>
        <h2>Jam operasional</h2>
        <p>Senin–Sabtu: 09.00–18.00</p>
        <p>Minggu: Tutup<br />(konsultasi via WhatsApp tetap dibalas)</p>
      </div>
      <nav class="footer-socials" aria-label="Sosial Chère Cake Atelier">
        <h2>Tetap terhubung</h2>
        {socials.map((social) => (
          <a href={social.href}>{social.label}</a>
        ))}
        <a href="#faq">Pertanyaan pemesanan</a>
      </nav>
    </div>

    <div class="footer-colophon">
      <p>© {new Date().getFullYear()} Chère Cake Atelier. Semua hak cipta dilindungi.</p>
      <p>
        Fotografi inspirasi dari <a href="https://www.pexels.com">Pexels</a>.
        Foto stok bukan dokumentasi karya asli Chère maupun pelanggan pemberi testimoni.
      </p>
    </div>
  </div>
</footer>
