---
import { photo, photoSet, photoSource } from "../data/images";
import "../styles/story.css";

const steps = [
  {
    title: "Ceritakan idemu",
    desc: "Konsultasi tema, warna, tanggal, dan jumlah porsi. Referensi Pinterest atau Instagram boleh dibawa.",
  },
  {
    title: "Lihat sketsa & quote",
    desc: "Sketsa desain dan estimasi harga dikirim dalam 1–2 hari. Termasuk satu revisi sketsa sebelum produksi.",
  },
  {
    title: "Konfirmasi dengan DP 50%",
    desc: "Setelah desain disepakati, DP 50% memulai produksi dan mengunci jadwal pengambilan.",
  },
  {
    title: "Saatnya merayakan",
    desc: "Ambil kue sesuai jadwal H-0 pagi/siang, atau pilih pengantaran dalam kota dengan box khusus anti-goyang.",
  },
];
---

<section id="cara-custom" class="section process-section" aria-labelledby="process-heading">
  <div class="container process-composition">
    <div class="process-copy">
      <h2 id="process-heading" class="section-heading">Dari ide ke<br />kue nyata.</h2>
      <p class="section-intro">Tidak perlu sudah punya semua jawabannya. Mulai dari satu cerita, kita rancang sisanya bersama.</p>
      <ol class="process-sequence">
        {steps.map((step, index) => (
          <li>
            <span class="process-number" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href="#konsultasi" class="text-link">Mulai konsultasi desain</a>
    </div>
    <div class="process-visual">
      <figure class="process-photo">
        <img src={photo(8478047)} srcset={photoSet(8478047)} sizes="(max-width: 800px) 100vw, 42vw" alt="Proses menghias cake dengan cream dan alat pastry" width="960" height="1200" loading="lazy" decoding="async" />
        <figcaption class="photo-note"><a href={photoSource(8478047)} target="_blank" rel="noreferrer">Inspirasi proses pastry · Pexels</a> — bukan dokumentasi staf Chère.</figcaption>
      </figure>
      <div class="process-lead-times">
        <h3>Sisihkan waktu untuk yang spesial.</h3>
        <dl>
          <div><dt>Desain simpel</dt><dd>H-3</dd></div>
          <div><dt>Custom design</dt><dd>H-7</dd></div>
          <div><dt>Wedding cake</dt><dd>H-14</dd></div>
        </dl>
        <p>Minimal pre-order sebelum tanggal acara.</p>
      </div>
    </div>
  </div>
</section>
