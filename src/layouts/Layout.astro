---
import "../styles/global.css";
import { assetBase, heroImage } from "../data/images";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Chère Cake Atelier — Custom Cake & Dessert Table Jakarta",
  description = "Cake custom dan dessert table untuk setiap cerita: birthday, wedding, dan corporate gifting. Pilih inspirasi, rasa, dan mulai konsultasi desain gratis bersama Chère.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://cherecakeatelier.id");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: "Chère Cake Atelier",
  description,
  image: heroImage.url,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Jakarta Selatan",
    addressCountry: "ID",
  },
  telephone: "+62-812-3456-7890",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "09:00",
      closes: "18:00",
    },
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: { "@type": "Product", name: "Simple Custom Cake" },
      priceCurrency: "IDR",
      price: "350000",
    },
    {
      "@type": "Offer",
      itemOffered: { "@type": "Product", name: "Custom Design Cake" },
      priceCurrency: "IDR",
      price: "650000",
    },
    {
      "@type": "Offer",
      itemOffered: { "@type": "Product", name: "Premium/Wedding Cake" },
      priceCurrency: "IDR",
      price: "1500000",
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="custom cake Jakarta, kue ulang tahun custom, wedding cake custom, dessert table, kue tema karakter anak"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImage.url} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImage.url} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <meta name="theme-color" content="#F5B8CD" />
    <link rel="preload" href={`${assetBase}fonts/bricolage-grotesque-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${assetBase}fonts/manrope-latin.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-canvas text-body">
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <slot />
  </body>
</html>
